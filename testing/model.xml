    <spatial name="spring3" rgba="0 0 1 1" stiffness="100" damping="100" springlength="0.75">
      <site site="red_box__near" />
      <site site="green_box__near" />
    </spatial>
    <spatial name="spring6" rgba="0 0 1 1" stiffness="100" damping="100" springlength="0.75">
      <site site="red_box__top_middle" />
      <site site="green_box__top_middle" />
    </spatial>
    <spatial name="spring4" rgba="0 0 1 1" stiffness="0" damping="0" springlength="0.00">
      <site site="red_box__mid" />
      <geom geom="dummy__dummy" />
      <site site="dummy__red" />
    </spatial>
    <spatial name="spring5" rgba="0 0 1 1" stiffness="0" damping="0" springlength="0.00">
      <site site="green_box__mid" />
      <geom geom="dummy__dummy" />
      <site site="dummy__green" />
    </spatial> -->
    <spatial name="chain_red" limited="true" range="0 1" rgba="0 0 0 1">
      <site site="red_box__top" />
      <site site="crane_base__crane_site" />
    </spatial>
    <spatial name="chain_green" limited="true" range="0 1" rgba="0 0 0 1">
      <site site="green_box__top" />
      <site site="crane_base__crane_site" />
    </spatial>
  </tendon>
  <actuator>
    <position name="lift" joint="crane_base__up_down" kp="7000" kv="2000" ctrlrange="-0.5 2.0" />
